# =============================================================================
# Vault Environment Variables
# Copy this file to your vault root as `.env` and fill in your actual values.
# This file is gitignored and should never be committed.
# =============================================================================

# Google (Gmail, Calendar, Drive, Docs connectors)
# Get OAuth credentials at https://console.cloud.google.com
# Enable: Gmail API, Calendar API, Drive API, Docs API
# Scopes: gmail.modify, calendar, drive
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Fathom (meeting transcripts, optional for End of Day routine)
# Get your API key at https://app.fathom.video/settings/api
FATHOM_API_KEY=

# Slack (optional for End of Day routine)
# Create a Slack app at https://api.slack.com/apps
# Scopes: channels:history, channels:read, chat:write, im:history, im:read, mpim:history, mpim:read, users:read
SLACK_TOKEN_WORKSPACE_A=
